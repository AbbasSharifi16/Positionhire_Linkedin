# ============================================================================
# PositionHire LinkedIn Telegram Bot — configuration
# Copy this file to ".env" and fill in the real values. Never commit .env.
# ============================================================================

# --- Telegram ---------------------------------------------------------------
# Get this by messaging @BotFather on Telegram -> /newbot -> copy the token.
TELEGRAM_BOT_TOKEN=123456789:AAExampleBotTokenReplaceMe

# Comma-separated list of Telegram numeric user IDs allowed to use the bot.
# The bot will reply with your ID the first time you message it, so you can
# leave this empty at first, message the bot, then paste your ID here.
ALLOWED_TELEGRAM_USER_IDS=

# --- Your website API -------------------------------------------------------
# The bot runs on the same VPS as the site, so it talks to it over localhost.
# (Port 5000 is what backend/server.js listens on.)
SITE_API_BASE=http://localhost:5000/api

# Admin login the bot uses to post (same credentials you use in the admin panel).
# "username" accepts either your admin username OR your admin email.
ADMIN_USERNAME=your-admin-username-or-email
ADMIN_PASSWORD=your-admin-password
